#!/usr/bin/env bash
# peerbackup-host — provision and tear down storage grants for peers.
#
# This is what you run when a friend asks you to hold their backups. It creates
# a preallocated disk image, mounts it, and hands the mounted directory to an
# unprivileged rest-server container.
#
#   peerbackup-host quickstart <peer>         start a server and add a peer
#   peerbackup-host provision <peer> <size>   e.g. provision nisse 500G
#   peerbackup-host adduser   <peer> [pw]     create credential + restart + verify
#   peerbackup-host release   <peer>          ordered teardown, destroys data
#   peerbackup-host list                      grants, sizes, usage
#   peerbackup-host guard                     fail-closed mountpoint check
#   peerbackup-host doctor                    check the host is set up correctly
#
# A few things that are easy to get wrong:
#
#   * Images are PREALLOCATED, never sparse. A sparse image caps the inner
#     filesystem but reserves no host blocks, so granting 500G to three friends
#     on a 1T disk still lets the host fill up. fallocate, not truncate.
#
#   * Mounting needs CAP_SYS_ADMIN, which the internet-facing container must not
#     have. So the host mounts; the container receives an already-mounted dir.
#
#   * `guard` is the fail-closed check. If Docker starts before the mounts
#     settle, bind mounts resolve to ordinary directories on the root filesystem
#     with no size limit, and the first symptom is a full disk. It runs as
#     ExecStartPre so the container refuses to start instead.
#
#   * The MAINTENANCE RESERVE is reported here but enforced by the CLIENT.
#     rest-server's --max-size is per instance, and one instance serves every
#     grantee, so there is no server-side per-peer reserve. Both sides have to
#     agree on the number, so this prints it.
#
# DRY_RUN=1 prints what would happen and touches nothing. Used by the tests.

set -uo pipefail

# 51515 is in the dynamic port range, so it is unlikely to collide with
# something already running. 8000 collides constantly.
DEFAULT_PORT=51515
# Somewhere an ordinary user can write. /srv needs root, which defeats the
# point of a setup that otherwise does not.
DEFAULT_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/peerbackup-data"

ROOT="${PEERBACKUP_ROOT:-/srv/peerbackup}"
IMAGES="$ROOT/images"
MNT="$ROOT/mnt"
UNITS="${SYSTEMD_UNIT_DIR:-/etc/systemd/system}"
RESERVE_PCT="${MAINTENANCE_RESERVE_PCT:-15}"
# Never let grants consume the last of the host disk, even if each grant is legal.
HOST_MARGIN_GB="${HOST_MARGIN_GB:-20}"
DRY_RUN="${DRY_RUN:-0}"
# Set by adduser when it generates a password, so quickstart can print a URL
# the peer can paste directly.
GENERATED_PW=""

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$*" >&2; }
info() { printf '%s\n' "$*"; }
# Commands are passed as a single pre-quoted string so DRY_RUN can print exactly
# what would run. eval is the point here, not an accident.
# shellcheck disable=SC2294
run()  { if [ "$DRY_RUN" = "1" ]; then printf '  would run: %s\n' "$*"; else eval "$@"; fi; }

need_root() {
  [ "$DRY_RUN" = "1" ] && return 0
  [ "$(id -u)" -eq 0 ] || die "must run as root (mount, losetup and systemd all need it)"
}

# Parse 500G / 500GB / 512000M / 1T into bytes. Rejects anything else loudly,
# because a silently misparsed size means a grant of the wrong magnitude.
to_bytes() {
  local s="${1^^}" n unit
  n="${s%%[KMGT]*}"; unit="${s#"$n"}"; unit="${unit%B}"
  case "$n" in ''|*[!0-9]*) die "bad size '$1' (use e.g. 500G)";; esac
  case "$unit" in
    K) echo $(( n * 1024 ));;
    M) echo $(( n * 1024 * 1024 ));;
    G) echo $(( n * 1024 * 1024 * 1024 ));;
    T) echo $(( n * 1024 * 1024 * 1024 * 1024 ));;
    '') echo "$n";;
    *) die "bad size unit in '$1' (use K, M, G or T)";;
  esac
}

human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "${1}B"; }

unit_name() {
  command -v systemd-escape >/dev/null 2>&1 \
    || die "systemd-escape not found; cannot derive the mount unit name for '$1'"
  local n; n=$(systemd-escape --path --suffix=mount "$MNT/$1")
  [ -n "$n" ] || die "systemd-escape produced an empty unit name for '$MNT/$1'"
  echo "$n"
}

# True when nothing is listening on the port.
#
# The connection attempt runs in a subshell, so there is no descriptor to close
# afterwards. Do not be tempted to add `exec 3>&- 2>/dev/null`: an `exec` with
# only redirections applies them permanently to the current shell, which
# silently sends every later error message to /dev/null.
port_free() {
  ! (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null
}

peer_valid() {
  case "$1" in
    ''|*[!a-zA-Z0-9_-]*) return 1;;
    *) return 0;;
  esac
}

# ------------------------------------------------------------------ provision
cmd_provision() {
  local peer="${1:-}" size="${2:-}"
  [ -n "$peer" ] && [ -n "$size" ] || die "usage: peerbackup-host provision <peer> <size>"
  peer_valid "$peer" || die "peer name must be [a-zA-Z0-9_-] only (it becomes a path and a unit name)"
  need_root

  local img="$IMAGES/$peer.img" dir="$MNT/$peer"
  [ -e "$img" ] && die "$img already exists; use 'release $peer' first if you mean to replace it"

  local bytes; bytes=$(to_bytes "$size")

  # Admission control. Preallocation means the host must actually have the room
  # right now, not eventually. Refuse rather than overcommit.
  #
  # This check runs in DRY_RUN too, deliberately. A dry run that skips the one
  # safety check you would want before committing 500GB is not a dry run, it is
  # a rehearsal of the happy path.
  local probe="$IMAGES"
  while [ ! -d "$probe" ] && [ "$probe" != "/" ]; do probe=$(dirname "$probe"); done
  local avail_kb avail margin
  avail_kb=$(df -Pk "$probe" 2>/dev/null | awk 'NR==2{print $4}')
  avail=$(( ${avail_kb:-0} * 1024 ))
  margin=$(( HOST_MARGIN_GB * 1024 * 1024 * 1024 ))
  info "requested:      $(human "$bytes")"
  info "host available: $(human "$avail")  (on $probe)"
  info "safety margin:  $(human "$margin")"
  if [ $(( bytes + margin )) -gt "$avail" ]; then
    die "refusing to overcommit: $(human "$bytes") + $(human "$margin") margin exceeds $(human "$avail") available on $probe"
  fi

  # Required tools, checked before we start creating things. systemd-escape in
  # particular used to be missing silently: unit_name returned empty, the unit
  # was written to a garbage path, and provision reported success on a grant
  # that would never mount.
  local missing=""
  for t in fallocate mkfs.ext4 systemd-escape stat; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  [ -n "$missing" ] && die "missing required tool(s):$missing (need util-linux, e2fsprogs and systemd)"

  run "mkdir -p '$IMAGES' '$MNT'"

  info "allocating $img (preallocated, this is not instant)"
  run "fallocate -l $bytes '$img'" || die "fallocate failed (filesystem may not support preallocation; dd is NOT equivalent, investigate)"

  # -m 0 drops ext4's default 5% root reservation. The peer paid for that space.
  #
  # -E nodiscard is NOT optional and is the subtlest line in this file. mkfs.ext4
  # issues discards by default, which on a file-backed image punches holes and
  # silently undoes the fallocate above:
  #
  #     after fallocate:           allocated = 64M
  #     after mkfs.ext4 (default): allocated = 4.5M   <- preallocation destroyed
  #     after mkfs -E nodiscard:   allocated = 64M
  #
  # Without it every grant is sparse, and the host can be overcommitted by
  # exactly the mechanism this design exists to prevent.
  run "mkfs.ext4 -q -m 0 -E nodiscard -F '$img'"

  # Verify the FINAL state, not an intermediate one. The first version of this
  # check ran immediately after fallocate, passed, and was then invalidated by
  # the very next command. Check what you are actually shipping.
  if [ "$DRY_RUN" != "1" ]; then
    local apparent allocated blk
    apparent=$(stat -c %s "$img" 2>/dev/null || echo 0)
    blk=$(stat -c %B "$img" 2>/dev/null || echo 512)
    allocated=$(( $(stat -c %b "$img" 2>/dev/null || echo 0) * blk ))
    if [ "$allocated" -lt $(( apparent / 2 )) ]; then
      rm -f "$img"
      die "refusing to create a sparse grant: only $(human "$allocated") of $(human "$apparent") is actually allocated.
       A sparse image is not a quota. The host can still be filled by other grants.
       Either $IMAGES is on a filesystem that does not really preallocate
       (overlayfs, tmpfs, some network mounts), or mkfs discarded the allocation.
       Put $IMAGES on ext4, xfs or btrfs on real block storage."
    fi
    info "preallocation verified after mkfs: $(human "$allocated") reserved on the host"
  fi

  run "mkdir -p '$dir'"

  local unit; unit=$(unit_name "$peer")
  info "writing $UNITS/$unit"
  if [ "$DRY_RUN" = "1" ]; then
    printf '  would write mount unit for %s -> %s\n' "$img" "$dir"
  else
    cat > "$UNITS/$unit" <<EOF
[Unit]
Description=peerbackup storage grant for $peer
Documentation=https://github.com/nisse/peerbackup

[Mount]
What=$img
Where=$dir
Type=ext4
Options=loop,rw,noatime

[Install]
WantedBy=multi-user.target
EOF
  fi

  run "systemctl daemon-reload"
  run "systemctl enable --now '$unit'"

  # A freshly formatted filesystem is owned by root, and mkfs.ext4 always
  # creates lost+found as root:0700 whatever the parent looks like. The server
  # runs as an ordinary user, so without this it cannot write to the grant at
  # all, and both `adduser` and the startup mount check fail with permission
  # denied. -R matters: lost+found alone is enough to break it.
  # PB_UID wins so it can match the service file. Otherwise the person who ran
  # sudo, since they are the one who will want to inspect the data later.
  local own_uid="${PB_UID:-${SUDO_UID:-$(id -u)}}"
  local own_gid="${PB_GID:-${SUDO_GID:-$(id -g)}}"

  if [ "$DRY_RUN" = "1" ]; then
    printf '  would run: chown %s:%s %s\n' "$own_uid" "$own_gid" "$MNT"
    printf '  would run: chown -R %s:%s %s\n' "$own_uid" "$own_gid" "$dir"
  else
    # The parent holds rest-server's .htpasswd. Left as root, every `adduser`
    # fails with permission denied, which is the first thing anyone hits.
    chown "$own_uid:$own_gid" "$MNT" \
      || die "could not give $MNT to $own_uid:$own_gid; creating logins will fail"

    if ! mountpoint -q "$dir"; then
      die "$dir is not mounted after enabling $unit, so it cannot be prepared.
       Check: systemctl status $unit"
    fi
    # -R matters. mkfs.ext4 always creates lost+found as root:0700 whatever the
    # parent looks like, and that alone fails the server's startup mount check.
    chown -R "$own_uid:$own_gid" "$dir" \
      || die "could not give $dir to $own_uid:$own_gid; the server cannot write to it"
    info "grant and $MNT owned by $own_uid:$own_gid"
  fi

  info ""
  info "grant created for '$peer'. Numbers that matter, all three of them:"
  cmd_list "$peer"
  info ""
  info "next: create their credential"
  info "  peerbackup-host adduser $peer"
  info "(use that, not create_user directly: rest-server only reads the htpasswd"
  info " file at startup, so a credential added without a restart returns 401)"
}

# -------------------------------------------------------------------- release
cmd_release() {
  local peer="${1:-}"
  [ -n "$peer" ] || die "usage: peerbackup-host release <peer>"
  peer_valid "$peer" || die "invalid peer name"
  need_root

  local img="$IMAGES/$peer.img" dir="$MNT/$peer" unit
  unit=$(unit_name "$peer")
  [ -e "$img" ] || [ -d "$dir" ] || die "no grant found for '$peer'"

  warn "this destroys $peer's backups permanently. They cannot be recovered from here."
  if [ "${FORCE:-0}" != "1" ] && [ "$DRY_RUN" != "1" ]; then
    printf "type the peer name to confirm: "
    read -r confirm
    [ "$confirm" = "$peer" ] || die "aborted"
  fi

  # Order matters. `rm` on a mounted image is not a teardown: the space stays
  # allocated to the open loop device and the mount keeps serving stale data.
  run "systemctl disable --now '$unit' 2>/dev/null || true"
  if mountpoint -q "$dir" 2>/dev/null; then
    run "umount '$dir'" || die "umount failed; something still has $dir open (lsof +f -- $dir)"
  fi
  local loopdev
  loopdev=$(losetup -j "$img" 2>/dev/null | cut -d: -f1)
  if [ -n "$loopdev" ]; then
    run "losetup -d '$loopdev'" || warn "could not detach $loopdev"
  fi
  run "rm -f '$img'"
  run "rmdir '$dir' 2>/dev/null || true"
  run "rm -f '$UNITS/$unit'"
  run "systemctl daemon-reload"
  info "grant for '$peer' released, capacity returned to the host"
}

# ----------------------------------------------------------------------- list
cmd_list() {
  local only="${1:-}"
  [ -d "$MNT" ] || { info "no grants"; return 0; }
  printf '%-14s %12s %12s %12s %12s  %s\n' PEER IMAGE USABLE RESERVE USED STATE
  local found=0
  for dir in "$MNT"/*; do
    [ -d "$dir" ] || continue
    local peer; peer=$(basename "$dir")
    [ -n "$only" ] && [ "$peer" != "$only" ] && continue
    found=1
    local img="$IMAGES/$peer.img"
    local imgsz=0 usable=0 used=0 reserve=0 state="NOT MOUNTED"
    [ -f "$img" ] && imgsz=$(stat -c %s "$img" 2>/dev/null || echo 0)
    if mountpoint -q "$dir" 2>/dev/null; then
      state="mounted"
      local kb; kb=$(df -Pk "$dir" 2>/dev/null | awk 'NR==2{print $2}')
      usable=$(( ${kb:-0} * 1024 ))
      kb=$(df -Pk "$dir" 2>/dev/null | awk 'NR==2{print $3}')
      used=$(( ${kb:-0} * 1024 ))
      reserve=$(( usable * RESERVE_PCT / 100 ))
    fi
    printf '%-14s %12s %12s %12s %12s  %s\n' \
      "$peer" "$(human "$imgsz")" "$(human "$usable")" "$(human "$reserve")" "$(human "$used")" "$state"
  done
  [ "$found" = "0" ] && info "no grants"
  info ""
  info "USABLE is capacity after filesystem overhead, which is less than IMAGE."
  info "RESERVE (${RESERVE_PCT}%) is how much headroom prune needs to repack."
  info "Nothing enforces it today. It is shown so you can leave room by hand:"
  info "if USED climbs past USABLE minus RESERVE, prune may be unable to run."
  info "rest-server's --max-size is per instance, not per peer, so it cannot"
  info "enforce it either."
  return 0
}

# ---------------------------------------------------------------------- guard
# Fail-closed. Runs as ExecStartPre on the container unit.
cmd_guard() {
  local rc=0 checked=0
  [ -d "$MNT" ] || die "$MNT does not exist; nothing provisioned"
  for dir in "$MNT"/*; do
    [ -d "$dir" ] || continue
    checked=$((checked+1))
    if mountpoint -q "$dir"; then
      printf '  ok       %s\n' "$dir"
    else
      printf '  NOT MOUNTED  %s\n' "$dir" >&2
      rc=1
    fi
  done
  if [ "$checked" -eq 0 ]; then
    die "no grant directories under $MNT; refusing to start a server with nothing to serve"
  fi
  if [ "$rc" -ne 0 ]; then
    die "refusing to start: a grant directory is not a mountpoint, so writes would land on the host root filesystem with no quota"
  fi
  info "all $checked grant(s) mounted"
}

# --------------------------------------------------------------------- doctor
cmd_doctor() {
  local problems=0
  command -v docker >/dev/null || { warn "docker not found"; problems=$((problems+1)); }
  command -v fallocate >/dev/null || { warn "fallocate not found (util-linux)"; problems=$((problems+1)); }
  command -v mkfs.ext4 >/dev/null || { warn "mkfs.ext4 not found (e2fsprogs)"; problems=$((problems+1)); }
  command -v systemd-escape >/dev/null || { warn "systemd-escape not found"; problems=$((problems+1)); }
  [ -d "$ROOT" ] || warn "$ROOT does not exist yet (provision will create it)"

  # The gotcha that silently breaks quota monitoring: the rest-server image runs
  # as uid 0 and creates repos 0700 root:root through the bind mount.
  if [ -d "$MNT" ]; then
    for dir in "$MNT"/*; do
      [ -d "$dir" ] || continue
      for repo in "$dir"/*; do
        [ -d "$repo" ] || continue
        if [ ! -r "$repo" ]; then
          warn "$repo is not readable by $(id -un) — the container is probably running without --user, which breaks quota monitoring"
          problems=$((problems+1))
        fi
        break
      done
    done
  fi

  if [ "$problems" -eq 0 ]; then info "host looks healthy"; else info "$problems problem(s) found"; fi
  return 0
}

# ------------------------------------------------------------------ quickstart
# Start a server and hand back a URL, in one command and without root.
#
# Uses a plain directory rather than a preallocated image, so the size limit is
# rest-server's and is shared across all peers. `provision` is the version with
# a per-peer limit the kernel enforces.
cmd_quickstart() {
  local peer="${1:-}"
  local port="${PB_PORT:-$DEFAULT_PORT}"
  local data="${PB_DATA:-$DEFAULT_DATA}"
  local container="${PB_CONTAINER:-peerbackup-rest}"
  [ -n "$peer" ] || die "usage: peerbackup-host quickstart <peer-name>"
  peer_valid "$peer" || die "peer name must be [a-zA-Z0-9_-] only"
  command -v docker >/dev/null || die "docker is required"
  docker info >/dev/null 2>&1 || die "cannot talk to docker; is the daemon running and are you in the docker group?"

  mkdir -p "$data" 2>/dev/null || die "cannot create $data
       Pick somewhere you can write: PB_DATA=/path peerbackup-host quickstart $peer"
  [ -w "$data" ] || die "$data exists but is not writable by $(id -un)
       Either: sudo chown -R $(id -un) '$data'
       Or pick another: PB_DATA=/path peerbackup-host quickstart $peer"

  if docker ps --format '{{.Names}}' | grep -qx "$container"; then
    # Being up is not the same as serving on the port we are about to hand out.
    # A container left over from an earlier setup listens somewhere else, and
    # skipping this check is how a URL that cannot work gets printed.
    if ! curl -s -o /dev/null "http://127.0.0.1:$port/" 2>/dev/null; then
      die "a container named '$container' is already running, but nothing answers
       on port $port. It is probably left over from an earlier setup using a
       different port or storage directory.

       Look at it:  docker ps --filter name=$container
       Remove it:   docker rm -f $container
       Then run this again."
    fi
    info "server already running on port $port, adding a peer to it"
  else
    docker rm -f "$container" >/dev/null 2>&1 || true
    port_free "$port" || die "port $port is already in use on this machine
       Choose another: PB_PORT=51516 peerbackup-host quickstart $peer"

    info "starting the server on port $port"
    docker run -d --name "$container" --restart unless-stopped \
      --user "$(id -u):$(id -g)" \
      -p "$port:8000" \
      -v "$data:/data" \
      -e OPTIONS="--private-repos --append-only --max-size ${PB_MAX_SIZE:-536870912000}" \
      restic/rest-server:0.14.0 >/dev/null 2>&1 \
      || die "docker could not start the server. Full error:
$(docker run --rm --user "$(id -u):$(id -g)" -p "$port:8000" -v "$data:/data" restic/rest-server:0.14.0 2>&1 | head -3)"

    # Do not trust `docker run` exiting 0: the container can start and then die.
    local up=0
    for _ in $(seq 1 60); do
      if docker ps --format '{{.Names}}' | grep -qx "$container" \
         && curl -s -o /dev/null "http://127.0.0.1:$port/" 2>/dev/null; then
        up=1; break
      fi
      sleep 0.25
    done
    if [ "$up" != "1" ]; then
      warn "the server did not come up. Its log:"
      docker logs "$container" 2>&1 | tail -10 >&2
      docker rm -f "$container" >/dev/null 2>&1 || true
      die "could not start the server on port $port"
    fi
  fi

  GENERATED_PW=""
  QUIET=1 PB_PORT="$port" PB_CONTAINER="$container" cmd_adduser "$peer" >/dev/null \
    || die "server is running but the login for '$peer' could not be created"
  [ -n "$GENERATED_PW" ] || die "no password was generated for '$peer'"

  local host; host=$(hostname -f 2>/dev/null || hostname)
  info ""
  info "Ready. Send this to $peer, over something you trust:"
  info ""
  info "  rest:http://$peer:$GENERATED_PW@$host:$port/$peer/"
  info ""
  info "They run:  peerbackup connect '<that url>' --source /path/to/back/up"
  info ""
  info "Storage:   $data"
  info "Port $port must reach this machine. Use TLS if it is exposed to the"
  info "internet: see the README."
}

cmd_up()   { run "docker compose -f '$(dirname "$0")/../compose.yml' up -d"; }
cmd_down() { run "docker compose -f '$(dirname "$0")/../compose.yml' down"; }

# ------------------------------------------------------------------- adduser
# rest-server loads .htpasswd ONCE at startup and never reloads it. Its own log
# line says so: "Loaded htpasswd file /data/.htpasswd". A credential created
# after the server is running returns 401 until the container restarts, which
# looks exactly like a wrong password and sends both sides off debugging TLS.
#
# So this subcommand exists purely to make the correct sequence unavoidable:
# create the user, restart, then verify the credential actually works before
# handing it to anyone.
cmd_adduser() {
  local peer="${1:-}" pw="${2:-}" container="${PB_CONTAINER:-peerbackup-rest}"
  local port="${PB_PORT:-$DEFAULT_PORT}"
  [ -n "$peer" ] || die "usage: peerbackup-host adduser <peer> [password]"
  peer_valid "$peer" || die "invalid peer name"

  if [ -z "$pw" ]; then
    pw=$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 24)
    GENERATED_PW="$pw"
    if [ "${QUIET:-0}" != "1" ]; then
      info "generated password for '$peer': $pw"
      info "send it over a channel you trust. It is not stored anywhere in plaintext."
    fi
  fi

  local mk_out
  if ! mk_out=$(docker exec "$container" create_user "$peer" "$pw" 2>&1); then
    warn "$mk_out"
    die "could not create the login for '$peer' on container '$container'.
       If the message above mentions /data, the server's storage directory is
       missing or not writable. Check what it is mounted on:
         docker inspect -f '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{end}}' $container"
  fi
  if [ "${QUIET:-0}" != "1" ]; then
    info "restarting the server so it picks up the new credential (it only reads"
    info "the htpasswd file at startup)"
  fi
  run "docker restart '$container'"

  if [ "$DRY_RUN" = "1" ]; then return 0; fi

  local code=""
  for _ in $(seq 1 40); do
    code=$(curl -s -o /dev/null -w '%{http_code}' -u "$peer:$pw" \
      "http://127.0.0.1:$port/$peer/config" 2>/dev/null)
    # 404 means authenticated but no repository yet, which is exactly right for
    # a fresh grant. 200 means they already have one.
    case "$code" in 404|200) break;; esac
    sleep 0.5
  done
  case "$code" in
    404|200)
      [ "${QUIET:-0}" = "1" ] || info "verified: credential for '$peer' authenticates (HTTP $code)"
      ;;
    401)     die "the login for '$peer' still fails after a restart. The server is
       running but does not accept it; check its htpasswd file.";;
    *)       die "could not confirm the login for '$peer' works (HTTP ${code:-no response}).
       Nothing is answering on port $port, so the server is not serving there.
       Check it:   docker ps --filter name=$container
       Remove it:  docker rm -f $container";;
  esac
}

usage() {
  sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

case "${1:-}" in
  quickstart) shift; cmd_quickstart "$@";;
  provision) shift; cmd_provision "$@";;
  adduser)   shift; cmd_adduser "$@";;
  release)   shift; cmd_release "$@";;
  list)      shift; cmd_list "$@";;
  guard)     shift; cmd_guard "$@";;
  doctor)    shift; cmd_doctor "$@";;
  up)        shift; cmd_up "$@";;
  down)      shift; cmd_down "$@";;
  -h|--help|help|'') usage 0;;
  *) die "unknown command '$1' (try --help)";;
esac
